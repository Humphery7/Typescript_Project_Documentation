# Base URL of your deployed backend, no trailing slash.
# Local development: http://localhost:3000
VITE_API_URL=http://localhost:3000

# Shop name shown in the header and page titles.
VITE_STORE_NAME=Meridian

# Show the "Add product" page. Leave false in production until the backend
# protects POST /products (it is currently open to anyone).
VITE_SHOW_ADMIN=false

# Show Stripe's test card number on the bag page. Use only in test mode.
VITE_STRIPE_TEST_HINT=true
